// Stateless MCP + interactive gallery on Workers Free. No Containers or Durable Objects.
// Confirm Workers Free before remote import/deployment; the free plan hard-stops at quotas.
// The public catalog is isolated from the existing private submissions/account database.
{
  "name": "biocartoon-mcp",
  "main": "src/mcp.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "mcp.biocartoon.com", "custom_domain": true }],
  "workers_dev": false,
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "d1_databases": [{
    "binding": "CATALOG", "database_name": "biocartoon-catalog",
    "database_id": "42877efa-f7d5-4f61-b829-3637ddace9aa"
  }],
  "services": [{ "binding": "SUBMISSIONS", "service": "biocartoon-submit" }]
}
