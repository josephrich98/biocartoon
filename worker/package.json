{
  "name": "biocartoon-submissions",
  "license": "BSD-2-Clause",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to .wrangler/state",
    "dev:review": "wrangler dev -c wrangler.review.jsonc --port 8788 --persist-to .wrangler/state --var DEV_NO_AUTH:1",
    "migrate:local": "wrangler d1 migrations apply biocartoon-submissions --local --persist-to .wrangler/state",
    "migrate": "wrangler d1 migrations apply biocartoon-submissions --remote",
    "deploy": "wrangler deploy && wrangler deploy -c wrangler.review.jsonc",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "obscenity": "^0.4.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
